{
  "expo": {
    "name": "XFactory Fit",
    "slug": "xfactory-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "xfactoryfit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xfactory.fit",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "XFactory Fit reminds you when a planned training day is ready."
      }
    },
    "android": {
      "package": "com.xfactory.fit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#101412"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#D6F25C"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101412",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#101412",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "XFactory Fit uses your country so Hindi is hidden in Pakistan and Urdu is hidden in India."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
